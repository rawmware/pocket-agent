# --- Model provider -------------------------------------------------------
# One OpenAI-compatible endpoint covers OpenRouter, DeepSeek, Together, xAI,
# Alibaba, Zhipu, Moonshot, Ollama (local), LM Studio, vLLM...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-paste-your-key-here

# --- Models ---------------------------------------------------------------
# Cheap workhorse for everyday chat. OpenRouter slugs look like "provider/model".
# If you point LLM_BASE_URL at DeepSeek directly, use "deepseek-chat" instead.
DEFAULT_MODEL=deepseek/deepseek-chat
# Smarter model for hard tasks (pick 🧠 in the UI). Empty = same as default.
SMART_MODEL=

# --- Cost guard -----------------------------------------------------------
# The agent refuses new work once today's estimated spend passes this.
DAILY_BUDGET_USD=2.00
# Rough $ per 1M tokens, used for the budget math. Override for your model.
PRICE_IN_PER_MTOK=0.30
PRICE_OUT_PER_MTOK=1.20
# Max tool-call rounds per reply.
MAX_TOOL_STEPS=25

# --- Optional -------------------------------------------------------------
# Web search needs a Tavily key (free tier at tavily.com). Without it the
# agent can still fetch any URL you give it via web_fetch.
TAVILY_API_KEY=

# --- Paths ----------------------------------------------------------------
WORKSPACE_DIR=./workspace
MEMORY_DIR=./memory
DATA_DIR=./data

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
